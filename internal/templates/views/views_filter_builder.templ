package views

import (
	"fmt"
	"net/url"

	"github.com/damongolding/immich-kiosk/internal/common"
	"github.com/damongolding/immich-kiosk/internal/templates/partials"
)

func filterBuilderNavLink(path, password string) string {
	if password == "" {
		return path
	}
	return path + "?password=" + url.QueryEscape(password)
}

templ FilterBuilder(d common.FilterBuilderViewData) {
	@HTMLTag(d.ViewData.SystemLang) {
		<head>
			@partials.Head(d.ViewData)
			<style>
				:root {
					--fb-bg: #0f1117;
					--fb-card-bg: rgba(26, 31, 46, 0.75);
					--fb-card-border: rgba(255, 255, 255, 0.08);
					--fb-accent: #3b82f6;
					--fb-accent-hover: #2563eb;
					--fb-accent-glow: rgba(59, 130, 246, 0.35);
					--fb-text-main: #f3f4f6;
					--fb-text-muted: #9ca3af;
					--fb-code-bg: #090d16;
				}

				body#filter-builder-page {
					background-color: var(--fb-bg);
					color: var(--fb-text-main);
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
					margin: 0;
					padding: 0;
					min-height: 100vh;
				}

				.filter-builder-navbar {
					background: rgba(15, 17, 23, 0.85);
					backdrop-filter: blur(12px);
					border-bottom: 1px solid var(--fb-card-border);
					padding: 1rem 2rem;
					display: flex;
					align-items: center;
					justify-content: space-between;
					position: sticky;
					top: 0;
					z-index: 50;
				}

				.filter-builder-brand {
					display: flex;
					align-items: center;
					gap: 0.75rem;
				}

				.filter-builder-brand h1 {
					font-size: 1.25rem;
					font-weight: 700;
					margin: 0;
					background: linear-gradient(135deg, #60a5fa, #a78bfa);
					-webkit-background-clip: text;
					-webkit-text-fill-color: transparent;
				}

				.filter-builder-badge {
					font-size: 0.75rem;
					background: rgba(59, 130, 246, 0.15);
					color: #93c5fd;
					border: 1px solid rgba(59, 130, 246, 0.3);
					padding: 0.2rem 0.6rem;
					border-radius: 9999px;
					font-weight: 500;
				}

				.filter-builder-navlinks {
					display: flex;
					align-items: center;
					gap: 1rem;
				}

				.filter-builder-navlinks a {
					color: var(--fb-text-muted);
					text-decoration: none;
					font-size: 0.9rem;
					padding: 0.4rem 0.8rem;
					border-radius: 6px;
					transition: all 0.2s ease;
				}

				.filter-builder-navlinks a:hover {
					color: #fff;
					background: rgba(255, 255, 255, 0.06);
				}

				.filter-builder-container {
					max-width: 1400px;
					margin: 0 auto;
					padding: 2rem;
				}

				.filter-builder-editor-section {
					background: var(--fb-card-bg);
					backdrop-filter: blur(16px);
					border: 1px solid var(--fb-card-border);
					border-radius: 14px;
					padding: 1.5rem;
					margin-bottom: 2.5rem;
					box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
				}

				.filter-builder-presets-bar {
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					gap: 0.5rem;
					margin-bottom: 1.25rem;
				}

				.filter-builder-presets-label {
					font-size: 0.85rem;
					color: var(--fb-text-muted);
					font-weight: 600;
					margin-right: 0.5rem;
				}

				.btn-preset {
					background: rgba(255, 255, 255, 0.05);
					border: 1px solid rgba(255, 255, 255, 0.1);
					color: #e5e7eb;
					padding: 0.35rem 0.75rem;
					border-radius: 6px;
					font-size: 0.82rem;
					cursor: pointer;
					transition: all 0.2s ease;
					display: inline-flex;
					align-items: center;
					gap: 0.35rem;
				}

				.btn-preset:hover {
					background: rgba(59, 130, 246, 0.2);
					border-color: rgba(59, 130, 246, 0.5);
					color: #93c5fd;
				}

				.filter-builder-controls-row {
					display: flex;
					align-items: center;
					justify-content: space-between;
					flex-wrap: wrap;
					gap: 1rem;
					margin-bottom: 0.75rem;
				}

				.filter-builder-dropdowns {
					display: flex;
					align-items: center;
					gap: 1rem;
					flex-wrap: wrap;
				}

				.filter-builder-field-group {
					display: flex;
					align-items: center;
					gap: 0.5rem;
				}

				.filter-builder-field-group label {
					font-size: 0.85rem;
					color: var(--fb-text-muted);
				}

				.filter-builder-field-group select {
					background: #111827;
					border: 1px solid rgba(255, 255, 255, 0.15);
					color: #f3f4f6;
					padding: 0.4rem 0.8rem;
					border-radius: 6px;
					font-size: 0.85rem;
					outline: none;
				}

				.filter-builder-textarea-wrapper {
					position: relative;
					margin-bottom: 1rem;
				}

				.filter-builder-textarea {
					width: 100%;
					min-height: 160px;
					box-sizing: border-box;
					background: var(--fb-code-bg);
					border: 1px solid rgba(255, 255, 255, 0.15);
					border-radius: 8px;
					padding: 1rem;
					color: #67e8f9;
					font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
					font-size: 0.95rem;
					line-height: 1.5;
					resize: vertical;
					outline: none;
					transition: border-color 0.2s ease;
				}

				.filter-builder-textarea:focus {
					border-color: var(--fb-accent);
					box-shadow: 0 0 0 2px var(--fb-accent-glow);
				}

				.filter-builder-actions-row {
					display: flex;
					align-items: center;
					justify-content: space-between;
					flex-wrap: wrap;
					gap: 1rem;
				}

				.filter-builder-btn-run {
					background: linear-gradient(135deg, #3b82f6, #6366f1);
					color: #fff;
					border: none;
					padding: 0.65rem 1.6rem;
					border-radius: 8px;
					font-size: 0.95rem;
					font-weight: 600;
					cursor: pointer;
					display: inline-flex;
					align-items: center;
					gap: 0.5rem;
					transition: all 0.2s ease;
					box-shadow: 0 4px 14px 0 var(--fb-accent-glow);
				}

				.filter-builder-btn-run:hover {
					background: linear-gradient(135deg, #2563eb, #4f46e5);
					transform: translateY(-1px);
					box-shadow: 0 6px 18px 0 var(--fb-accent-glow);
				}

				.filter-builder-btn-format {
					background: rgba(255, 255, 255, 0.08);
					border: 1px solid rgba(255, 255, 255, 0.12);
					color: #e5e7eb;
					padding: 0.4rem 0.8rem;
					border-radius: 6px;
					font-size: 0.82rem;
					cursor: pointer;
					transition: all 0.2s ease;
				}

				.filter-builder-btn-format:hover {
					background: rgba(255, 255, 255, 0.15);
				}

				.filter-builder-hint {
					font-size: 0.8rem;
					color: var(--fb-text-muted);
				}

				/* Mode Tabs */
				.fb-mode-tabs {
					display: flex;
					gap: 0.5rem;
					border-bottom: 1px solid var(--fb-card-border);
					margin-bottom: 1.25rem;
					padding-bottom: 0.25rem;
				}

				.fb-mode-tab {
					background: transparent;
					border: none;
					color: var(--fb-text-muted);
					font-size: 0.95rem;
					font-weight: 600;
					padding: 0.6rem 1.2rem;
					border-radius: 8px;
					cursor: pointer;
					display: inline-flex;
					align-items: center;
					gap: 0.5rem;
					transition: all 0.2s ease;
				}

				.fb-mode-tab:hover {
					color: #fff;
					background: rgba(255, 255, 255, 0.05);
				}

				.fb-mode-tab.active {
					color: #60a5fa;
					background: rgba(59, 130, 246, 0.12);
					box-shadow: inset 0 -2px 0 #3b82f6;
				}

				/* Allowed Keywords Bar */
				.allowed-keywords-bar {
					background: rgba(15, 23, 42, 0.65);
					border: 1px solid rgba(255, 255, 255, 0.08);
					border-radius: 8px;
					padding: 0.6rem 0.9rem;
					display: flex;
					flex-wrap: wrap;
					align-items: center;
					gap: 0.45rem;
					margin-bottom: 1.25rem;
				}

				.allowed-keywords-label {
					font-size: 0.8rem;
					color: #94a3b8;
					font-weight: 600;
					display: inline-flex;
					align-items: center;
					gap: 0.35rem;
					margin-right: 0.25rem;
				}

				.keyword-chip {
					font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
					font-size: 0.76rem;
					padding: 0.2rem 0.55rem;
					background: rgba(59, 130, 246, 0.1);
					border: 1px solid rgba(59, 130, 246, 0.25);
					color: #93c5fd;
					border-radius: 5px;
					cursor: pointer;
					transition: all 0.18s ease;
					user-select: none;
				}

				.keyword-chip:hover {
					background: rgba(59, 130, 246, 0.28);
					border-color: #60a5fa;
					color: #ffffff;
					transform: translateY(-1px);
				}

				/* Visual Composer Grid */
				.vis-composer-grid {
					display: grid;
					grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
					gap: 1.25rem;
					margin-bottom: 1.25rem;
				}

				.vis-card {
					background: rgba(17, 24, 39, 0.55);
					border: 1px solid rgba(255, 255, 255, 0.08);
					border-radius: 10px;
					padding: 1.1rem;
					display: flex;
					flex-direction: column;
					gap: 0.75rem;
					transition: border-color 0.2s ease, box-shadow 0.2s ease;
				}

				.vis-card:hover {
					border-color: rgba(255, 255, 255, 0.16);
				}

				.vis-card.highlight-flash {
					border-color: #3b82f6;
					box-shadow: 0 0 16px rgba(59, 130, 246, 0.4);
				}

				.vis-card-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
				}

				.vis-card-title {
					font-size: 0.82rem;
					font-weight: 700;
					text-transform: uppercase;
					letter-spacing: 0.05em;
					color: #93c5fd;
					display: flex;
					align-items: center;
					gap: 0.45rem;
				}

				.vis-card-hint {
					font-size: 0.75rem;
					color: var(--fb-text-muted);
				}

				.vis-chip-group {
					display: flex;
					flex-wrap: wrap;
					gap: 0.45rem;
				}

				.vis-chip {
					background: rgba(255, 255, 255, 0.05);
					border: 1px solid rgba(255, 255, 255, 0.12);
					color: #cbd5e1;
					padding: 0.4rem 0.8rem;
					border-radius: 6px;
					font-size: 0.82rem;
					font-weight: 500;
					cursor: pointer;
					display: inline-flex;
					align-items: center;
					gap: 0.35rem;
					transition: all 0.15s ease;
					user-select: none;
				}

				.vis-chip:hover {
					background: rgba(255, 255, 255, 0.1);
					color: #fff;
					border-color: rgba(255, 255, 255, 0.25);
				}

				.vis-chip.active {
					background: #2563eb;
					border-color: #60a5fa;
					color: #ffffff;
					font-weight: 600;
					box-shadow: 0 0 10px rgba(37, 99, 235, 0.4);
				}

				.vis-chip.active-fav {
					background: #dc2626;
					border-color: #f87171;
					color: #ffffff;
					box-shadow: 0 0 10px rgba(220, 38, 38, 0.4);
				}

				.vis-chip.active-star {
					background: #d97706;
					border-color: #fbbf24;
					color: #ffffff;
					box-shadow: 0 0 10px rgba(217, 119, 6, 0.4);
				}

				.vis-input {
					background: rgba(9, 13, 22, 0.8);
					border: 1px solid rgba(255, 255, 255, 0.12);
					color: #f3f4f6;
					padding: 0.45rem 0.75rem;
					border-radius: 6px;
					font-size: 0.85rem;
					outline: none;
					width: 100%;
					box-sizing: border-box;
					transition: border-color 0.2s, box-shadow 0.2s;
				}

				.vis-input:focus {
					border-color: var(--fb-accent);
					box-shadow: 0 0 0 2px var(--fb-accent-glow);
				}

				.vis-input::placeholder {
					color: #64748b;
				}

				.vis-field-row {
					display: flex;
					gap: 0.6rem;
					align-items: center;
				}

				.vis-field-col {
					display: flex;
					flex-direction: column;
					gap: 0.25rem;
					flex: 1;
				}

				.vis-field-label {
					font-size: 0.72rem;
					color: var(--fb-text-muted);
					text-transform: uppercase;
					letter-spacing: 0.04em;
					font-weight: 600;
				}

				/* Live Generated JSON Box */
				.vis-live-json-wrapper {
					background: rgba(9, 13, 22, 0.9);
					border: 1px solid rgba(255, 255, 255, 0.08);
					border-radius: 8px;
					margin-bottom: 1.25rem;
					overflow: hidden;
				}

				.vis-live-json-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
					padding: 0.5rem 0.85rem;
					background: rgba(255, 255, 255, 0.03);
					border-bottom: 1px solid rgba(255, 255, 255, 0.06);
					font-size: 0.78rem;
					color: var(--fb-text-muted);
					cursor: pointer;
					user-select: none;
				}

				.vis-live-json-header:hover {
					background: rgba(255, 255, 255, 0.05);
					color: #cbd5e1;
				}

				.vis-live-json-code {
					padding: 0.75rem 1rem;
					font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
					font-size: 0.82rem;
					color: #67e8f9;
					white-space: pre-wrap;
					margin: 0;
					max-height: 140px;
					overflow-y: auto;
				}

				.btn-clear-filters {
					background: rgba(255, 255, 255, 0.06);
					border: 1px solid rgba(255, 255, 255, 0.12);
					color: #cbd5e1;
					padding: 0.6rem 1.1rem;
					border-radius: 8px;
					font-size: 0.9rem;
					font-weight: 500;
					cursor: pointer;
					display: inline-flex;
					align-items: center;
					gap: 0.4rem;
					transition: all 0.2s ease;
				}

				.btn-clear-filters:hover {
					background: rgba(239, 68, 68, 0.15);
					border-color: rgba(239, 68, 68, 0.35);
					color: #fca5a5;
				}

				/* Loading Indicator */
				.htmx-indicator {
					display: none;
				}
				.htmx-request .htmx-indicator {
					display: inline-flex !important;
				}
				.htmx-request.htmx-indicator {
					display: inline-flex !important;
				}

				.spinner {
					width: 18px;
					height: 18px;
					border: 2px solid rgba(255,255,255,0.3);
					border-radius: 50%;
					border-top-color: #fff;
					animation: spin 0.8s linear infinite;
				}

				@keyframes spin {
					to { transform: rotate(360deg); }
				}

				/* Results Styling */
				.filter-builder-results-container {
					margin-top: 1rem;
				}

				.filter-builder-alert {
					padding: 1.25rem 1.5rem;
					border-radius: 10px;
					display: flex;
					gap: 1rem;
					align-items: flex-start;
					margin-bottom: 2rem;
				}

				.filter-builder-alert--error {
					background: rgba(239, 68, 68, 0.12);
					border: 1px solid rgba(239, 68, 68, 0.3);
					color: #fca5a5;
				}

				.filter-builder-alert--empty {
					background: rgba(148, 163, 184, 0.08);
					border: 1px solid rgba(148, 163, 184, 0.2);
					color: #cbd5e1;
				}

				.filter-builder-alert h4 {
					margin: 0 0 0.25rem 0;
					font-size: 1rem;
				}

				.filter-builder-alert p {
					margin: 0;
					font-size: 0.9rem;
					line-height: 1.4;
				}

				.filter-builder-summary {
					display: flex;
					align-items: center;
					justify-content: space-between;
					margin-bottom: 1.5rem;
				}

				.filter-builder-badge-count {
					display: flex;
					align-items: center;
					gap: 0.6rem;
					font-size: 1rem;
					color: #d1d5db;
				}

				.count-pill {
					background: #3b82f6;
					color: #fff;
					font-weight: 700;
					padding: 0.2rem 0.6rem;
					border-radius: 6px;
					font-size: 0.95rem;
				}

				.filter-builder-export-grid {
					display: grid;
					grid-template-columns: 1fr 1fr;
					gap: 1.25rem;
					margin-bottom: 2.5rem;
				}

				@media (max-width: 900px) {
					.filter-builder-export-grid {
						grid-template-columns: 1fr;
					}
				}

				.filter-builder-export-card {
					background: rgba(17, 24, 39, 0.7);
					border: 1px solid var(--fb-card-border);
					border-radius: 10px;
					padding: 1rem 1.25rem;
				}

				.filter-builder-export-header {
					display: flex;
					align-items: center;
					justify-content: space-between;
					margin-bottom: 0.6rem;
					font-size: 0.85rem;
					font-weight: 600;
					color: #9ca3af;
				}

				.filter-builder-export-actions {
					display: flex;
					gap: 0.5rem;
				}

				.btn-copy, .btn-launch {
					background: rgba(255, 255, 255, 0.08);
					border: 1px solid rgba(255, 255, 255, 0.12);
					color: #e5e7eb;
					padding: 0.3rem 0.65rem;
					border-radius: 5px;
					font-size: 0.78rem;
					cursor: pointer;
					display: inline-flex;
					align-items: center;
					gap: 0.35rem;
					text-decoration: none;
					transition: all 0.2s ease;
				}

				.btn-copy:hover, .btn-launch:hover {
					background: rgba(59, 130, 246, 0.2);
					color: #93c5fd;
					border-color: rgba(59, 130, 246, 0.4);
				}

				.filter-builder-code-block {
					background: var(--fb-code-bg);
					border: 1px solid rgba(255, 255, 255, 0.05);
					border-radius: 6px;
					padding: 0.75rem;
					overflow-x: auto;
				}

				.filter-builder-code-block code, .filter-builder-code-block pre {
					font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
					font-size: 0.82rem;
					color: #93c5fd;
					margin: 0;
					white-space: pre-wrap;
					word-break: break-all;
				}

				.filter-builder-gallery-header {
					display: flex;
					align-items: baseline;
					gap: 0.75rem;
					margin-bottom: 1.25rem;
				}

				.filter-builder-gallery-header h3 {
					font-size: 1.3rem;
					margin: 0;
					font-weight: 700;
				}

				.gallery-subtitle {
					font-size: 0.85rem;
					color: var(--fb-text-muted);
				}

				.filter-builder-grid {
					display: grid;
					grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
					gap: 1.25rem;
				}

				.filter-builder-card {
					background: rgba(26, 31, 46, 0.6);
					border: 1px solid rgba(255, 255, 255, 0.07);
					border-radius: 10px;
					overflow: hidden;
					display: flex;
					flex-direction: column;
					transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
				}

				.filter-builder-card:hover {
					transform: translateY(-4px);
					box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.5);
					border-color: rgba(59, 130, 246, 0.4);
				}

				.filter-builder-card-media {
					position: relative;
					width: 100%;
					padding-top: 68%;
					background: #111827;
					overflow: hidden;
				}

				.filter-builder-card-link {
					position: absolute;
					top: 0;
					left: 0;
					width: 100%;
					height: 100%;
					display: block;
				}

				.filter-builder-card-thumb {
					width: 100%;
					height: 100%;
					object-fit: cover;
					transition: transform 0.3s ease;
				}

				.filter-builder-card:hover .filter-builder-card-thumb {
					transform: scale(1.05);
				}

				.filter-builder-card-badges {
					position: absolute;
					top: 0.5rem;
					left: 0.5rem;
					right: 0.5rem;
					display: flex;
					flex-wrap: wrap;
					gap: 0.35rem;
					pointer-events: none;
				}

				.badge {
					font-size: 0.7rem;
					font-weight: 700;
					padding: 0.15rem 0.45rem;
					border-radius: 4px;
					text-shadow: 0 1px 2px rgba(0,0,0,0.8);
					backdrop-filter: blur(6px);
				}

				.badge-favorite {
					background: rgba(239, 68, 68, 0.85);
					color: #fff;
				}

				.badge-rating {
					background: rgba(234, 179, 8, 0.85);
					color: #fff;
				}

				.badge-video {
					background: rgba(99, 102, 241, 0.85);
					color: #fff;
				}

				.badge-user {
					background: rgba(16, 185, 129, 0.85);
					color: #fff;
				}

				.filter-builder-card-meta {
					padding: 0.85rem;
					display: flex;
					flex-direction: column;
					gap: 0.4rem;
					flex: 1;
				}

				.filter-builder-meta-location, .filter-builder-meta-date {
					display: flex;
					align-items: center;
					gap: 0.4rem;
					font-size: 0.78rem;
					color: #cbd5e1;
				}

				.filter-builder-meta-people {
					display: flex;
					flex-wrap: wrap;
					gap: 0.25rem;
					margin-top: 0.2rem;
				}

				.person-tag {
					background: rgba(255, 255, 255, 0.08);
					border: 1px solid rgba(255, 255, 255, 0.1);
					font-size: 0.7rem;
					color: #93c5fd;
					padding: 0.1rem 0.4rem;
					border-radius: 4px;
				}

				.filter-builder-meta-filename {
					font-size: 0.72rem;
					color: #64748b;
					margin-top: auto;
					padding-top: 0.4rem;
					text-overflow: ellipsis;
					overflow: hidden;
					white-space: nowrap;
				}
			</style>
		</head>
		<body id="filter-builder-page" class="notranslate">
			<!-- Top Navigation Bar -->
			<nav class="filter-builder-navbar">
				<div class="filter-builder-brand">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2">
						<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
						<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
						<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
					</svg>
					<h1>Filter Builder</h1>
					<span class="filter-builder-badge">Immich 3.2.0 Search v2</span>
				</div>
				<div class="filter-builder-navlinks">
					<a href={ templ.SafeURL(filterBuilderNavLink("/url-builder", d.ViewData.Config.Kiosk.Password)) }>URL Builder</a>
					<a href={ templ.SafeURL(filterBuilderNavLink("/url-builder/extended", d.ViewData.Config.Kiosk.Password)) }>Extended Options</a>
					<a href={ templ.SafeURL(filterBuilderNavLink("/", d.ViewData.Config.Kiosk.Password)) }>Launch Kiosk</a>
				</div>
			</nav>

			<main class="filter-builder-container">
				<!-- Filter Editor Section -->
				<section class="filter-builder-editor-section">
					<!-- Mode Switcher Tabs -->
					<div class="fb-mode-tabs" role="tablist">
						<button type="button" id="tab-btn-visual" class="fb-mode-tab active" onclick="switchMode('visual')">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
							</svg>
							<span>✨ Visual Click & Select</span>
						</button>
						<button type="button" id="tab-btn-raw" class="fb-mode-tab" onclick="switchMode('raw')">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polyline points="16 18 22 12 16 6"></polyline>
								<polyline points="8 6 2 12 8 18"></polyline>
							</svg>
							<span>💻 Raw JSON Payload</span>
						</button>
					</div>

					<form
						id="filter-builder-form"
						action="/filter-builder/search"
						method="POST"
						onsubmit="runSimulation(event); return false;"
						if d.ViewData.Config.Kiosk.Password != "" {
							hx-headers={ templ.JSONString(map[string]string{
								"Authorization": fmt.Sprintf("Bearer %s", d.ViewData.Config.Kiosk.Password),
							}) }
						}
					>
						if d.ViewData.Config.Kiosk.Password != "" {
							<input type="hidden" name="password" value={ d.ViewData.Config.Kiosk.Password }/>
						}

						<!-- VISUAL BUILDER PANEL (DEFAULT) -->
						<div id="visual-builder-panel">
							<!-- Allowed Keywords Reference Bar -->
							<div class="allowed-keywords-bar">
								<span class="allowed-keywords-label">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<circle cx="12" cy="12" r="10"></circle>
										<line x1="12" y1="16" x2="12" y2="12"></line>
										<line x1="12" y1="8" x2="12.01" y2="8"></line>
									</svg>
									Allowed Filter Keys:
								</span>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-fav')">+ isFavorite</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-rating')">+ rating</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-media')">+ type</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-media')">+ isMotion</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-location')">+ country</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-location')">+ state</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-location')">+ city</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-date')">+ takenAt</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-people')">+ withPeople</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-people')">+ isNotInAlbum</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('card-camera')">+ makeModel</button>
								<button type="button" class="keyword-chip" onclick="highlightCard('raw-hint-or')">+ or (branches)</button>
							</div>

							<!-- Visual Composer Grid -->
							<div class="vis-composer-grid">
								<!-- Card 1: Favorites -->
								<div id="card-fav" class="vis-card">
									<div class="vis-card-header">
										<span class="vis-card-title">
											<span>❤️</span> Favorites
										</span>
										<span class="vis-card-hint">isFavorite</span>
									</div>
									<div class="vis-chip-group">
										<button type="button" id="chip-fav-any" class="vis-chip active" onclick="setFavorite('any')">All Assets</button>
										<button type="button" id="chip-fav-true" class="vis-chip" onclick="setFavorite('true')">♥ Favorites Only</button>
										<button type="button" id="chip-fav-false" class="vis-chip" onclick="setFavorite('false')">🤍 Non-Favorites</button>
									</div>
								</div>

								<!-- Card 2: Media Type -->
								<div id="card-media" class="vis-card">
									<div class="vis-card-header">
										<span class="vis-card-title">
											<span>🎬</span> Media Type
										</span>
										<span class="vis-card-hint">type / isMotion</span>
									</div>
									<div class="vis-chip-group">
										<button type="button" id="chip-type-any" class="vis-chip active" onclick="setMediaType('any')">All Media</button>
										<button type="button" id="chip-type-image" class="vis-chip" onclick="setMediaType('IMAGE')">📷 Photos</button>
										<button type="button" id="chip-type-video" class="vis-chip" onclick="setMediaType('VIDEO')">🎥 Videos</button>
										<button type="button" id="chip-type-motion" class="vis-chip" onclick="setMediaType('MOTION')">⚡ Live / Motion</button>
									</div>
								</div>

								<!-- Card 3: Rating -->
								<div id="card-rating" class="vis-card">
									<div class="vis-card-header">
										<span class="vis-card-title">
											<span>⭐</span> Minimum Rating
										</span>
										<span class="vis-card-hint">rating: 1-5</span>
									</div>
									<div class="vis-chip-group">
										<button type="button" id="chip-rating-0" class="vis-chip active" onclick="setRating(0)">Any</button>
										<button type="button" id="chip-rating-1" class="vis-chip" onclick="setRating(1)">★ 1+</button>
										<button type="button" id="chip-rating-2" class="vis-chip" onclick="setRating(2)">★ 2+</button>
										<button type="button" id="chip-rating-3" class="vis-chip" onclick="setRating(3)">★ 3+</button>
										<button type="button" id="chip-rating-4" class="vis-chip" onclick="setRating(4)">★ 4+</button>
										<button type="button" id="chip-rating-5" class="vis-chip" onclick="setRating(5)">★ 5 Only</button>
									</div>
								</div>

								<!-- Card 4: Date Taken -->
								<div id="card-date" class="vis-card">
									<div class="vis-card-header">
										<span class="vis-card-title">
											<span>📅</span> Date Taken
										</span>
										<span class="vis-card-hint">takenAt range</span>
									</div>
									<div class="vis-chip-group">
										<button type="button" id="chip-date-any" class="vis-chip active" onclick="setDatePreset('any')">Any Time</button>
										<button type="button" id="chip-date-2025" class="vis-chip" onclick="setDatePreset('2025')">2025</button>
										<button type="button" id="chip-date-2024" class="vis-chip" onclick="setDatePreset('2024')">2024</button>
										<button type="button" id="chip-date-2023" class="vis-chip" onclick="setDatePreset('2023')">2023</button>
										<button type="button" id="chip-date-custom" class="vis-chip" onclick="setDatePreset('custom')">Custom Range</button>
									</div>
									<div id="vis-custom-date-row" class="vis-field-row" style="margin-top: 0.25rem;">
										<div class="vis-field-col">
											<span class="vis-field-label">From Date</span>
											<input type="date" id="vis-date-from" class="vis-input" onchange="onDateInputChange()"/>
										</div>
										<div class="vis-field-col">
											<span class="vis-field-label">To Date</span>
											<input type="date" id="vis-date-to" class="vis-input" onchange="onDateInputChange()"/>
										</div>
									</div>
								</div>

								<!-- Card 5: Location -->
								<div id="card-location" class="vis-card">
									<div class="vis-card-header">
										<span class="vis-card-title">
											<span>📍</span> Location
										</span>
										<span class="vis-card-hint">country, state, city</span>
									</div>
									<div class="vis-chip-group">
										<button type="button" class="vis-chip" onclick="setCountryChip('Japan')">Japan</button>
										<button type="button" class="vis-chip" onclick="setCountryChip('Italy')">Italy</button>
										<button type="button" class="vis-chip" onclick="setCountryChip('Germany')">Germany</button>
										<button type="button" class="vis-chip" onclick="setCountryChip('France')">France</button>
										<button type="button" class="vis-chip" onclick="setCountryChip('United States')">USA</button>
										<button type="button" class="vis-chip" onclick="setCountryChip('Brazil')">Brazil</button>
										<button type="button" class="vis-chip" onclick="setCountryChip('Spain')">Spain</button>
										<button type="button" class="vis-chip" onclick="setCountryChip('United Kingdom')">UK</button>
									</div>
									<input type="text" id="vis-country" class="vis-input" placeholder="Country name (e.g. Japan, Germany)" oninput="onLocationInputChange()"/>
									<div class="vis-field-row">
										<input type="text" id="vis-state" class="vis-input" placeholder="State/Region (e.g. Bavaria, California)" oninput="onLocationInputChange()"/>
										<input type="text" id="vis-city" class="vis-input" placeholder="City (e.g. Tokyo, Rome, Munich)" oninput="onLocationInputChange()"/>
									</div>
								</div>

								<!-- Card 6: People & Albums -->
								<div id="card-people" class="vis-card">
									<div class="vis-card-header">
										<span class="vis-card-title">
											<span>👥</span> People & Albums
										</span>
										<span class="vis-card-hint">withPeople, isNotInAlbum</span>
									</div>
									<div class="vis-chip-group">
										<button type="button" id="chip-people-any" class="vis-chip active" onclick="setPeople('any')">Any</button>
										<button type="button" id="chip-people-true" class="vis-chip" onclick="setPeople('true')">👤 With People</button>
										<button type="button" id="chip-people-false" class="vis-chip" onclick="setPeople('false')">🏞️ Landscape / No People</button>
									</div>
									<div class="vis-chip-group" style="margin-top: 0.25rem;">
										<button type="button" id="chip-album-any" class="vis-chip active" onclick="setAlbumStatus(false)">All Albums</button>
										<button type="button" id="chip-album-notin" class="vis-chip" onclick="setAlbumStatus(true)">📁 Not In Any Album</button>
									</div>
								</div>

								<!-- Card 7: Camera & Device -->
								<div id="card-camera" class="vis-card">
									<div class="vis-card-header">
										<span class="vis-card-title">
											<span>📷</span> Camera / Hardware
										</span>
										<span class="vis-card-hint">makeModel</span>
									</div>
									<input type="text" id="vis-camera" class="vis-input" placeholder="Camera/Phone model (e.g. iPhone, Sony, Canon, Pixel)" oninput="onCameraInputChange()"/>
								</div>
							</div>

							<!-- Live Generated JSON Box -->
							<div class="vis-live-json-wrapper">
								<div class="vis-live-json-header" onclick="toggleLiveJSON()">
									<div style="display: flex; align-items: center; gap: 0.6rem;">
										<span style="font-weight: 600; color: #93c5fd;">👁️ Live Compiled Filter:</span>
										<span id="vis-active-count-badge" class="count-pill" style="font-size: 0.72rem; padding: 0.1rem 0.45rem;">0 active rules</span>
									</div>
									<span id="vis-live-json-toggle-text">▾ Click to collapse</span>
								</div>
								<pre id="vis-live-json-code" class="vis-live-json-code">{}</pre>
							</div>
						</div>

						<!-- RAW JSON PANEL (ADVANCED) -->
						<div id="json-builder-panel" style="display: none;">
							<!-- Quick Presets -->
							<div class="filter-builder-presets-bar">
								<span class="filter-builder-presets-label">Presets:</span>
								<button type="button" class="btn-preset" onclick="setPreset('favorites')">
									<span>♥ Favorites</span>
								</button>
								<button type="button" class="btn-preset" onclick="setPreset('japan_rating')">
									<span>🗾 Japan & 4+ ★</span>
								</button>
								<button type="button" class="btn-preset" onclick="setPreset('tokyo_or_kyoto')">
									<span>🔀 OR (Tokyo / Kyoto)</span>
								</button>
								if len(d.Users) > 1 {
									<button type="button" class="btn-preset" onclick="setPreset('multi_user')">
										<span>👥 Multi-User Map</span>
									</button>
								}
								<button type="button" class="btn-preset" onclick="setPreset('taken_recent')">
									<span>📅 Year 2024</span>
								</button>
								<button type="button" class="btn-preset" onclick="setPreset('videos')">
									<span>▶ Videos Only</span>
								</button>
							</div>

							<div class="filter-builder-textarea-wrapper">
								<textarea
									id="filter-textarea"
									name="filter"
									class="filter-builder-textarea"
									spellcheck="false"
									placeholder="Enter JSON filter payload..."
								>{ d.InitialFilter }</textarea>
							</div>
						</div>

						<!-- SHARED CONTROLS & SUBMIT BAR -->
						<div class="filter-builder-controls-row">
							<div class="filter-builder-dropdowns">
								if len(d.Users) > 1 {
									<div class="filter-builder-field-group">
										<label for="user-select">Target Account:</label>
										<select id="user-select" name="user">
											<option value="all">👥 All Accounts / Multi-User Map</option>
											for _, u := range d.Users {
												<option value={ u }>{ u }</option>
											}
										</select>
									</div>
								} else if len(d.Users) == 1 {
									<input type="hidden" name="user" value={ d.Users[0] }/>
								} else {
									<input type="hidden" name="user" value=""/>
								}

								<div class="filter-builder-field-group">
									<label for="limit-select">Sample Size:</label>
									<select id="limit-select" name="limit">
										<option value="12">12 assets</option>
										<option value="24" selected>24 assets</option>
										<option value="48">48 assets</option>
										<option value="96">96 assets</option>
									</select>
								</div>
							</div>

							<div style="display: flex; gap: 0.5rem; align-items: center;">
								<button type="button" id="btn-format-json" class="filter-builder-btn-format" style="display: none;" onclick="formatJSON()">
									<span>{ } Format JSON</span>
								</button>
								<button type="button" class="btn-clear-filters" onclick="clearAllFilters()">
									<span>↺ Reset All</span>
								</button>
							</div>
						</div>

						<div class="filter-builder-actions-row">
							<button type="button" class="filter-builder-btn-run" onclick="runSimulation(event)">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
									<polygon points="5 3 19 12 5 21 5 3"></polygon>
								</svg>
								<span>Run Simulation</span>
							</button>

							<div id="loading-spinner" class="htmx-indicator" style="align-items: center; gap: 0.5rem; color: #93c5fd; font-size: 0.9rem;">
								<div class="spinner"></div>
								<span>Querying Immich API...</span>
							</div>

							<span id="raw-hint-or" class="filter-builder-hint">Select options above or switch to Raw JSON for custom multi-branch queries.</span>
						</div>
					</form>
				</section>

				<!-- Target container for htmx results -->
				<div id="filter-builder-results"></div>
			</main>

			<!-- Interactive Client Scripts -->
			<script>
				const presets = {
					favorites: JSON.stringify({ isFavorite: true }, null, 2),
					japan_rating: JSON.stringify({
						country: "Japan",
						rating: { gte: 4 }
					}, null, 2),
					tokyo_or_kyoto: JSON.stringify({
						country: "Japan",
						or: [
							{ city: "Tokyo" },
							{ city: "Kyoto" }
						]
					}, null, 2),
					multi_user: JSON.stringify({
						user1: { isFavorite: true, country: "Spain" },
						user2: { isFavorite: true, country: "Italy" }
					}, null, 2),
					taken_recent: JSON.stringify({
						takenAt: {
							gte: "2024-01-01T00:00:00Z",
							lte: "2024-12-31T23:59:59Z"
						}
					}, null, 2),
					videos: JSON.stringify({
						type: "VIDEO"
					}, null, 2)
				};

				// Visual Builder State
				const visState = {
					favorite: 'any',    // 'any', 'true', 'false'
					type: 'any',        // 'any', 'IMAGE', 'VIDEO', 'MOTION'
					rating: 0,          // 0, 1, 2, 3, 4, 5
					country: '',
					state: '',
					city: '',
					datePreset: 'any',  // 'any', '2025', '2024', '2023', 'custom'
					dateFrom: '',
					dateTo: '',
					people: 'any',      // 'any', 'true', 'false'
					notInAlbum: false,
					camera: ''
				};

				let currentMode = 'visual';

				function switchMode(mode) {
					currentMode = mode;
					const visPanel = document.getElementById("visual-builder-panel");
					const jsonPanel = document.getElementById("json-builder-panel");
					const tabVisual = document.getElementById("tab-btn-visual");
					const tabRaw = document.getElementById("tab-btn-raw");
					const btnFormat = document.getElementById("btn-format-json");

					if (mode === 'visual') {
						if (visPanel) visPanel.style.display = "block";
						if (jsonPanel) jsonPanel.style.display = "none";
						if (tabVisual) tabVisual.classList.add("active");
						if (tabRaw) tabRaw.classList.remove("active");
						if (btnFormat) btnFormat.style.display = "none";
						updateVisualFromJSON();
					} else {
						if (visPanel) visPanel.style.display = "none";
						if (jsonPanel) jsonPanel.style.display = "block";
						if (tabVisual) tabVisual.classList.remove("active");
						if (tabRaw) tabRaw.classList.add("active");
						if (btnFormat) btnFormat.style.display = "inline-flex";
						updateJSONFromVisual();
					}
				}

				function highlightCard(cardId) {
					const el = document.getElementById(cardId);
					if (el) {
						el.scrollIntoView({ behavior: 'smooth', block: 'center' });
						el.classList.add('highlight-flash');
						setTimeout(() => el.classList.remove('highlight-flash'), 1200);
					}
				}

				function setFavorite(val) {
					visState.favorite = val;
					['any', 'true', 'false'].forEach(k => {
						const chip = document.getElementById('chip-fav-' + k);
						if (!chip) return;
						chip.classList.toggle('active', k === val && k !== 'true');
						chip.classList.toggle('active-fav', k === val && k === 'true');
					});
					updateJSONFromVisual();
					runSimulation();
				}

				function setMediaType(val) {
					visState.type = val;
					const map = { any: 'any', IMAGE: 'image', VIDEO: 'video', MOTION: 'motion' };
					Object.keys(map).forEach(k => {
						const chip = document.getElementById('chip-type-' + map[k]);
						if (chip) chip.classList.toggle('active', k === val);
					});
					updateJSONFromVisual();
					runSimulation();
				}

				function setRating(val) {
					visState.rating = val;
					[0, 1, 2, 3, 4, 5].forEach(r => {
						const chip = document.getElementById('chip-rating-' + r);
						if (!chip) return;
						chip.classList.toggle('active', r === val && r === 0);
						chip.classList.toggle('active-star', r === val && r > 0);
					});
					updateJSONFromVisual();
					runSimulation();
				}

				function setCountryChip(name) {
					const input = document.getElementById('vis-country');
					if (!input) return;
					if (visState.country.toLowerCase() === name.toLowerCase()) {
						visState.country = '';
						input.value = '';
					} else {
						visState.country = name;
						input.value = name;
					}
					updateJSONFromVisual();
					runSimulation();
				}

				function onLocationInputChange() {
					const countryEl = document.getElementById('vis-country');
					const stateEl = document.getElementById('vis-state');
					const cityEl = document.getElementById('vis-city');
					if (countryEl) visState.country = countryEl.value.trim();
					if (stateEl) visState.state = stateEl.value.trim();
					if (cityEl) visState.city = cityEl.value.trim();
					updateJSONFromVisual();
				}

				function setDatePreset(preset) {
					visState.datePreset = preset;
					['any', '2025', '2024', '2023', 'custom'].forEach(p => {
						const chip = document.getElementById('chip-date-' + p);
						if (chip) chip.classList.toggle('active', p === preset);
					});
					const customRow = document.getElementById('vis-custom-date-row');
					if (customRow) {
						customRow.style.display = preset === 'custom' ? 'flex' : 'none';
					}
					updateJSONFromVisual();
					runSimulation();
				}

				function onDateInputChange() {
					const fromEl = document.getElementById('vis-date-from');
					const toEl = document.getElementById('vis-date-to');
					if (fromEl) visState.dateFrom = fromEl.value;
					if (toEl) visState.dateTo = toEl.value;
					updateJSONFromVisual();
				}

				function setPeople(val) {
					visState.people = val;
					['any', 'true', 'false'].forEach(k => {
						const chip = document.getElementById('chip-people-' + k);
						if (chip) chip.classList.toggle('active', k === val);
					});
					updateJSONFromVisual();
					runSimulation();
				}

				function setAlbumStatus(notInAlbum) {
					visState.notInAlbum = notInAlbum;
					const anyChip = document.getElementById('chip-album-any');
					const notInChip = document.getElementById('chip-album-notin');
					if (anyChip) anyChip.classList.toggle('active', !notInAlbum);
					if (notInChip) notInChip.classList.toggle('active', notInAlbum);
					updateJSONFromVisual();
					runSimulation();
				}

				function onCameraInputChange() {
					const cameraEl = document.getElementById('vis-camera');
					if (cameraEl) visState.camera = cameraEl.value.trim();
					updateJSONFromVisual();
				}

				function toggleLiveJSON() {
					const code = document.getElementById('vis-live-json-code');
					const toggleText = document.getElementById('vis-live-json-toggle-text');
					if (!code) return;
					if (code.style.display === 'none') {
						code.style.display = 'block';
						if (toggleText) toggleText.textContent = '▾ Click to collapse';
					} else {
						code.style.display = 'none';
						if (toggleText) toggleText.textContent = '▸ Click to expand';
					}
				}

				function updateJSONFromVisual() {
					const payload = {};
					let activeCount = 0;

					if (visState.favorite === 'true') { payload.isFavorite = true; activeCount++; }
					else if (visState.favorite === 'false') { payload.isFavorite = false; activeCount++; }

					if (visState.type === 'IMAGE') { payload.type = 'IMAGE'; activeCount++; }
					else if (visState.type === 'VIDEO') { payload.type = 'VIDEO'; activeCount++; }
					else if (visState.type === 'MOTION') { payload.isMotion = true; activeCount++; }

					if (visState.rating > 0) {
						activeCount++;
						if (visState.rating === 5) {
							payload.rating = 5;
						} else {
							payload.rating = { gte: visState.rating };
						}
					}

					if (visState.country) { payload.country = visState.country; activeCount++; }
					if (visState.state) { payload.state = visState.state; activeCount++; }
					if (visState.city) { payload.city = visState.city; activeCount++; }

					if (visState.datePreset === '2025') {
						payload.takenAt = { gte: '2025-01-01T00:00:00Z', lte: '2025-12-31T23:59:59Z' };
						activeCount++;
					} else if (visState.datePreset === '2024') {
						payload.takenAt = { gte: '2024-01-01T00:00:00Z', lte: '2024-12-31T23:59:59Z' };
						activeCount++;
					} else if (visState.datePreset === '2023') {
						payload.takenAt = { gte: '2023-01-01T00:00:00Z', lte: '2023-12-31T23:59:59Z' };
						activeCount++;
					} else if (visState.datePreset === 'custom') {
						const dateObj = {};
						if (visState.dateFrom) dateObj.gte = visState.dateFrom + 'T00:00:00Z';
						if (visState.dateTo) dateObj.lte = visState.dateTo + 'T23:59:59Z';
						if (Object.keys(dateObj).length > 0) {
							payload.takenAt = dateObj;
							activeCount++;
						}
					}

					if (visState.people === 'true') { payload.withPeople = true; activeCount++; }
					else if (visState.people === 'false') { payload.withPeople = false; activeCount++; }

					if (visState.notInAlbum) { payload.isNotInAlbum = true; activeCount++; }
					if (visState.camera) { payload.makeModel = visState.camera; activeCount++; }

					const formatted = JSON.stringify(payload, null, 2);
					const textarea = document.getElementById('filter-textarea');
					if (textarea) textarea.value = formatted;

					const liveCode = document.getElementById('vis-live-json-code');
					if (liveCode) liveCode.textContent = formatted;

					const countBadge = document.getElementById('vis-active-count-badge');
					if (countBadge) {
						countBadge.textContent = activeCount === 1 ? '1 active rule' : activeCount + ' active rules';
					}
				}

				function updateVisualFromJSON() {
					const textarea = document.getElementById('filter-textarea');
					if (!textarea) return;
					try {
						const data = JSON.parse(textarea.value || '{}');
						// favorites
						if (data.isFavorite === true) setFavorite('true');
						else if (data.isFavorite === false) setFavorite('false');
						else setFavorite('any');

						// media
						if (data.isMotion === true) setMediaType('MOTION');
						else if (data.type === 'IMAGE') setMediaType('IMAGE');
						else if (data.type === 'VIDEO') setMediaType('VIDEO');
						else setMediaType('any');

						// rating
						if (data.rating !== undefined) {
							if (typeof data.rating === 'number') setRating(data.rating);
							else if (data.rating && data.rating.gte) setRating(data.rating.gte);
							else setRating(0);
						} else {
							setRating(0);
						}

						// location
						visState.country = data.country || '';
						visState.state = data.state || '';
						visState.city = data.city || '';
						const countryEl = document.getElementById('vis-country');
						if (countryEl) countryEl.value = visState.country;
						const stateEl = document.getElementById('vis-state');
						if (stateEl) stateEl.value = visState.state;
						const cityEl = document.getElementById('vis-city');
						if (cityEl) cityEl.value = visState.city;

						// people
						if (data.withPeople === true) setPeople('true');
						else if (data.withPeople === false) setPeople('false');
						else setPeople('any');

						// album
						setAlbumStatus(data.isNotInAlbum === true);

						// camera
						visState.camera = data.makeModel || '';
						const cameraEl = document.getElementById('vis-camera');
						if (cameraEl) cameraEl.value = visState.camera;

						updateJSONFromVisual();
					} catch (e) {
						// Invalid JSON in raw textarea, ignore sync to visual
					}
				}

				function clearAllFilters() {
					visState.favorite = 'any';
					visState.type = 'any';
					visState.rating = 0;
					visState.country = '';
					visState.state = '';
					visState.city = '';
					visState.datePreset = 'any';
					visState.dateFrom = '';
					visState.dateTo = '';
					visState.people = 'any';
					visState.notInAlbum = false;
					visState.camera = '';

					// Reset inputs
					const ids = ['vis-country', 'vis-state', 'vis-city', 'vis-date-from', 'vis-date-to', 'vis-camera'];
					ids.forEach(id => {
						const el = document.getElementById(id);
						if (el) el.value = '';
					});

					// Reset chip classes
					setFavorite('any');
					setMediaType('any');
					setRating(0);
					setDatePreset('any');
					setPeople('any');
					setAlbumStatus(false);
					updateJSONFromVisual();
					runSimulation();
				}

				async function runSimulation(event) {
					if (event) {
						event.preventDefault();
						event.stopPropagation();
					}
					const form = document.getElementById("filter-builder-form");
					if (!form) return false;

					const spinner = document.getElementById("loading-spinner");
					if (spinner) spinner.style.display = "inline-flex";

					try {
						const formData = new FormData(form);
						const resp = await fetch("/filter-builder/search", {
							method: "POST",
							body: formData
						});
						if (!resp.ok) {
							throw new Error("HTTP " + resp.status + " " + resp.statusText);
						}
						const html = await resp.text();
						const target = document.getElementById("filter-builder-results");
						if (target) {
							target.outerHTML = html;
						}
					} catch (err) {
						console.error("Simulation request failed:", err);
						const target = document.getElementById("filter-builder-results");
						if (target) {
							target.innerHTML = `
								<div class="filter-builder-alert filter-builder-alert--error" role="alert">
									<div class="filter-builder-alert--icon">
										<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<circle cx="12" cy="12" r="10"></circle>
											<line x1="12" y1="8" x2="12" y2="12"></line>
											<line x1="12" y1="16" x2="12.01" y2="16"></line>
										</svg>
									</div>
									<div class="filter-builder-alert--content">
										<h4>Simulation Request Failed</h4>
										<p>${err.message}</p>
									</div>
								</div>`;
						}
					} finally {
						if (spinner) spinner.style.display = "none";
					}
					return false;
				}

				function setPreset(key) {
					const textarea = document.getElementById("filter-textarea");
					if (textarea && presets[key]) {
						textarea.value = presets[key];
						updateVisualFromJSON();
						runSimulation();
					}
				}

				function formatJSON() {
					const textarea = document.getElementById("filter-textarea");
					if (!textarea) return;
					try {
						const parsed = JSON.parse(textarea.value);
						textarea.value = JSON.stringify(parsed, null, 2);
					} catch (e) {
						alert("Cannot format: Invalid JSON syntax (" + e.message + ")");
					}
				}

				async function copySnippet(btn, elementId) {
					const el = document.getElementById(elementId);
					if (!el) return;
					const text = el.innerText || el.textContent;
					try {
						await navigator.clipboard.writeText(text);
						const originalHTML = btn.innerHTML;
						btn.innerHTML = '<span>✓ Copied!</span>';
						setTimeout(() => {
							btn.innerHTML = originalHTML;
						}, 2000);
					} catch (e) {
						console.error("Clipboard copy failed", e);
					}
				}

				// Initial setup on page load
				document.addEventListener("DOMContentLoaded", () => {
					updateVisualFromJSON();
					runSimulation();
				});

				if (document.readyState !== "loading") {
					updateVisualFromJSON();
					runSimulation();
				}

				// Ctrl+Enter / Cmd+Enter runs simulation
				document.addEventListener("keydown", (e) => {
					if ((e.ctrlKey || e.metaKey) && e.key === "Enter") {
						e.preventDefault();
						runSimulation();
					}
				});
			</script>
		</body>
	}
}
