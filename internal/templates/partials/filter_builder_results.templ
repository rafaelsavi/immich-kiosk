package partials

import (
	"strconv"
	"strings"

	"github.com/damongolding/immich-kiosk/internal/common"
)

templ FilterBuilderResult(d common.FilterBuilderResultData) {
	<div id="filter-builder-results" style="display: flex; flex-direction: column; gap: 1.25rem; width: 100%;">
		if d.Error != "" {
			<div class="playground-alert playground-alert--error" role="alert">
				<div style="flex-shrink: 0; padding-top: 2px;">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="10"></circle>
						<line x1="12" y1="8" x2="12" y2="12"></line>
						<line x1="12" y1="16" x2="12.01" y2="16"></line>
					</svg>
				</div>
				<div>
					<div style="font-weight: 700; margin-bottom: 0.25rem;">Filter Error</div>
					<div>{ d.Error }</div>
				</div>
			</div>
		} else if len(d.Assets) == 0 {
			<div class="playground-alert playground-alert--empty">
				<div style="flex-shrink: 0; padding-top: 2px;">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
				</div>
				<div>
					<div style="font-weight: 700; margin-bottom: 0.25rem;">No Matching Assets</div>
					<div>No photos or videos in Immich matched your filter criteria. Try loosening some conditions.</div>
				</div>
			</div>
		}

		if len(d.Assets) > 0 {
			<!-- Live Matching Assets Simulation -->
			<div class="simulation-gallery-card">
				<div class="simulation-gallery-header">
					<div class="simulation-title-wrap">
						<span style="font-weight: 700; font-size: 0.95rem; color: #0f172a;">Live Simulation</span>
						if d.Total > len(d.Assets) {
							if d.TotalExact {
								<span class="count-badge">{ strconv.Itoa(d.Total) } matching in Immich (showing { strconv.Itoa(len(d.Assets)) })</span>
							} else {
								<span class="count-badge">{ strconv.Itoa(d.Total) }+ matching in Immich (showing { strconv.Itoa(len(d.Assets)) })</span>
							}
						} else if d.Total > 0 {
							<span class="count-badge">All { strconv.Itoa(d.Total) } matching assets shown</span>
						} else {
							<span class="count-badge">Live preview ({ strconv.Itoa(len(d.Assets)) } matching assets)</span>
						}
					</div>

					<div class="simulation-limit-selector">
						<span class="limit-label">Sample:</span>
						for _, size := range []int{24, 48, 96, 144} {
							<button
								type="button"
								class={ "limit-pill", templ.KV("active", d.Limit == size || (d.Limit == 0 && size == 24)) }
								data-limit={ strconv.Itoa(size) }
								onclick="setPlaygroundLimit(this.dataset.limit)"
							>
								{ strconv.Itoa(size) }
							</button>
						}
					</div>
				</div>

				<div class="simulation-grid">
					for _, item := range d.Assets {
						<div class="simulation-thumb-card">
							<div class="thumb-media">
								<a href={ templ.SafeURL(item.ThumbnailURL) } target="_blank" title={ item.Filename }>
									<img
										src={ item.ThumbnailURL }
										alt={ item.Filename }
										loading="lazy"
										class="thumb-img"
										onerror="this.onerror=null; this.style.opacity='0.25';"
									/>
								</a>
								<div class="thumb-overlay-badges">
									if item.Type == "VIDEO" {
										<span class="overlay-pill video">▶ VIDEO</span>
									}
									if item.IsFavorite {
										<span class="overlay-pill fav">♥</span>
									}
									if item.Rating > 0 {
										<span class="overlay-pill rating">★ { strconv.Itoa(item.Rating) }</span>
									}
									if item.User != "" {
										<span class="overlay-pill user">{ "@" + item.User }</span>
									}
								</div>
							</div>
							<div class="thumb-meta">
								if item.TakenAt != "" {
									<div class="thumb-meta-date">{ item.TakenAt }</div>
								}
								if item.City != "" || item.Country != "" {
									<div class="thumb-meta-location" title={ locationString(item.City, item.Country) }>
										📍 { locationString(item.City, item.Country) }
									</div>
								}
								if len(item.People) > 0 {
									<div class="thumb-meta-people" title={ strings.Join(item.People, ", ") }>
										👤 { strings.Join(item.People, ", ") }
									</div>
								}
							</div>
						</div>
					}
				</div>

				if d.Total > len(d.Assets) {
					<div class="simulation-load-more">
						<button
							type="button"
							class="load-more-btn"
							onclick="increasePlaygroundLimit()"
						>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polyline points="6 9 12 15 18 9"></polyline>
							</svg>
							<span>Load more photos (+24)</span>
						</button>
					</div>
				}
			</div>
		}
	</div>
}

func locationString(city, country string) string {
	city = strings.TrimSpace(city)
	country = strings.TrimSpace(country)
	if city != "" && country != "" {
		return city + ", " + country
	}
	if city != "" {
		return city
	}
	return country
}

